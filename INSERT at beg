#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node *next;

} *header;

void createlist(int n);
void insertNodeAtBeginning(int data);
void traverseList(struct node *header);


int main() {

    int n, data;

    printf("enter the num of nodes\n");
    scanf("%d", &n);

    createlist(n);

    printf("\nEnter data to insert at beginning: ");
    scanf("%d", &data);

    insertNodeAtBeginning(data);

    printf("\nLinked List after insertion:\n");
    traverseList(header);

    return 0;
}


void createlist(int n) {

    struct node *newnode, *temp;
    int data, i;

    newnode = (struct node*)malloc(sizeof(struct node));

    if(newnode == NULL) {
        printf("unable to allocate memory\n");
    }
    else {
        printf("enter the data for node 1: ");
        scanf("%d", &data);
    }

    newnode->data = data;
    newnode->next = NULL;

    header = newnode;
    temp = newnode;


    for(int i = 2; i <= n; i++) {

        newnode = (struct node*)malloc(sizeof(struct node));

        if(newnode == NULL) {
            printf("unable to allocate memory\n");
            break;
        }
        else {
            printf("enter the data for node %d: ", i);
            scanf("%d", &data);
        }

        newnode->data = data;
        newnode->next = NULL;

        temp->next = newnode;
        temp = temp->next;
    }
}


/* Insert at beginning */

void insertNodeAtBeginning(int data) {

    struct node *newNode;

    newNode = (struct node*)malloc(sizeof(struct node));

    if(newNode == NULL) {
        printf("Unable to allocate memory.\n");
    }
    else {

        newNode->data = data;

        newNode->next = header;

        header = newNode;

        printf("DATA INSERTED SUCCESSFULLY\n");
    }
}


/* Traverse the linked list */

void traverseList(struct node *header) {

    struct node *temp;

    if(header == NULL) {

        printf("List is empty.");

    }
    else {

        temp = header;

        while(temp != NULL) {

            printf("Data = %d\n", temp->data);

            temp = temp->next;
        }
    }
}
