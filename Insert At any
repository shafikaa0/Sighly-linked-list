void insertatany(int data, int pos) {
    struct node *newnode, *temp;
    newnode = (struct node*)malloc(sizeof(struct node));
    
    if(newnode == NULL) {
        printf("unable");
    }
    else {
        newnode->data = data;
        newnode->next = NULL;

        if(pos == 1) {
            newnode->next = header;
            header = newnode;
        }
        else {
            temp = header;
            // ১. লুপের মাধ্যমে শুধু pos-1 পজিশনে পৌঁছান
            for(int i = 2; i <= pos - 1; i++) {
                if(temp == NULL) {
                    break;
                }
                temp = temp->next; 
            } 

            // ২. লুপ শেষ হওয়ার পর নোড যুক্ত করুন
            if(temp != NULL) {
                newnode->next = temp->next;
                temp->next = newnode;
            } else {
                printf("cannot insert"); 
            }
        }
    }
}
}
