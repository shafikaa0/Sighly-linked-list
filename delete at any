void deleteanynode(int pos) {
    struct node *todelete, *prevnode;

    if(header == NULL) {
        printf("already empty");
    }
    else if(pos < 1) {
        printf("invalid position");
    }
    else if(pos == 1) {
        todelete = header;
        header = header->next;

        todelete->next = NULL;

        printf("delete %d", todelete->data);
        free(todelete);
    }
    else {
        todelete = header;

        for(int i = 1; i < pos; i++) {
            prevnode = todelete;
            todelete = todelete->next;

            if(todelete == NULL) {
                printf("invalid position");
                return;
            }
        }

        prevnode->next = todelete->next;

        todelete->next = NULL;

        printf("delete %d", todelete->data);
        free(todelete);
    }
}
