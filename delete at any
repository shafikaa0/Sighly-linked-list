#include <stdio.h>
#include <stdlib.h>

struct node
{
    int data;
    struct node *next;

} *header;

void createlist(int n);
void deleteMiddleNode(int position);
void traverse(struct node *header);


int main()
{
    int n, pos;

    printf("enter the num of nodes: ");
    scanf("%d", &n);

    createlist(n);

    printf("\nOriginal Linked List:\n");
    traverse(header);

    printf("\nEnter the position to delete: ");
    scanf("%d", &pos);

    deleteMiddleNode(pos);

    printf("\nLinked List after deletion:\n");
    traverse(header);

    return 0;
}


/* Create the linked list */

void createlist(int n)
{
    int data;
    struct node *newnode, *temp;

    if(n <= 0)
    {
        header = NULL;
        return;
    }

    newnode = (struct node*)malloc(sizeof(struct node));

    if(newnode == NULL)
    {
        printf("Unable to allocate memory\n");
        return;
    }
    else
    {
        printf("enter data for node 1: ");
        scanf("%d", &data);

        newnode->data = data;
        newnode->next = NULL;

        header = newnode;
        temp = newnode;

        for(int i = 2; i <= n; i++)
        {
            newnode = (struct node*)malloc(sizeof(struct node));

            if(newnode == NULL)
            {
                printf("Unable to allocate memory\n");
                break;
            }
            else
            {
                printf("enter data for node %d: ", i);
                scanf("%d", &data);

                newnode->data = data;
                newnode->next = NULL;

                temp->next = newnode;
                temp = temp->next;
            }
        }
    }
}


/* Delete a node at any position */

void deleteMiddleNode(int position)
{
    int i;
    struct node *toDelete, *prevNode;
    if(header == NULL) {
        printf("List is already empty.");
    } else if(position < 1)
    {     printf("Invalid position unable to delete.");
    }else {
        toDelete = header;
        prevNode = header;
        for(i = 2; i <= position; i++) {
            prevNode = toDelete;
            toDelete = toDelete->next;
            if(toDelete == NULL)
                break; }
 if(toDelete != NULL)
        { if(toDelete == header)
            {   header = header->next;
            } else
            {
                prevNode->next = toDelete->next;
            } toDelete->next = NULL;
            free(toDelete);
            printf("SUCCESSFULLY DELETED NODE FROM LIST\n");
        } else{
            printf("Invalid position unable to delete."); }
    }
}


/* Traverse the linked list */

void traverse(struct node *header)
{
    struct node *temp;

    if(header == NULL)
    {
        printf("List is empty.\n");
    }
    else
    {
        temp = header;

        while(temp != NULL)
        {
            printf("Data = %d\n", temp->data);

            temp = temp->next;
        }
    }
}
