#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node *next;
} *header;

void createList(int n);
void traverseList();

int main()
{
    int n = 10;

    createList(n);
    traverseList();

    return 0;
}

void createList(int n)
{
    struct node *newNode, *temp;
    int data, i;

    newNode = (struct node *)malloc(sizeof(struct node));

    if(newNode == NULL)
    {
        return;
    }

    scanf("%d", &data);

    newNode->data = data;
    newNode->next = NULL;

    header = newNode;
    temp = newNode;

    for(i = 2; i <= n; i++)
    {
        newNode = (struct node *)malloc(sizeof(struct node));

        if(newNode == NULL)
        {
            break;
        }

        scanf("%d", &data);

        newNode->data = data;
        newNode->next = NULL;

        temp->next = newNode;
        temp = temp->next;
    }
}

void traverseList()
{
    struct node *temp;

    if(header == NULL)
    {
        printf("List is empty.");
    }
    else
    {
        temp = header;
        while(temp != NULL)
        {
            printf("Data = %d\n", temp->data);
            temp = temp->next;
        }
    }
}
